{
  "mcpServers": {
    "microsoft-project": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/run-ms-project-mcp.ps1"
      ],
      "env": {
        "MSP_MCP_BACKEND": "auto"
      },
      "timeout": 120000
    }
  }
}
